# EditorConfig is awesome: https://EditorConfig.org

root = true

# All
[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# 4 spaces indentation
[*.py]
indent_size = 4

# 2 spaces indentation
[*.json{5,},md,sh,toml,y{a,}ml]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
